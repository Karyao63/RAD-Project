<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RAD.AboutPage"
             Title="About Me"
             BackgroundColor="#121212">
    <ScrollView Padding="25">
        <VerticalStackLayout Spacing="20">

            <Label Text="Background" FontSize="22" FontAttributes="Bold" TextColor="#FFFFFF" />
            <Label Text="Currently a Computer Science student with a passion for building clean, user-friendly mobile applications and exploring system security." 
                   FontSize="16" LineHeight="1.5" TextColor="#B3B3B3" />

            <Label Text="Tech Stack" FontSize="22" FontAttributes="Bold" Margin="0,10,0,0" TextColor="#FFFFFF"/>

            <HorizontalStackLayout Spacing="10">
                <Frame x:Name="Skill1" Padding="15,8" BackgroundColor="#2C2C3E" CornerRadius="15" HasShadow="False" BorderColor="#7B61FF" Opacity="0">
                    <Label Text="C#" TextColor="#A58DFF" FontAttributes="Bold" />
                </Frame>
                <Frame x:Name="Skill2" Padding="15,8" BackgroundColor="#2C3E2C" CornerRadius="15" HasShadow="False" BorderColor="#4CAF50" Opacity="0">
                    <Label Text="Java" TextColor="#81C784" FontAttributes="Bold" />
                </Frame>
                <Frame x:Name="Skill3" Padding="15,8" BackgroundColor="#3E342C" CornerRadius="15" HasShadow="False" BorderColor="#FF9800" Opacity="0">
                    <Label Text="Python" TextColor="#FFB74D" FontAttributes="Bold" />
                </Frame>
            </HorizontalStackLayout>

            <Label Text="Interests" FontSize="22" FontAttributes="Bold" Margin="0,10,0,0" TextColor="#FFFFFF"/>

            <Frame BackgroundColor="#1E1E1E" BorderColor="#333333" CornerRadius="15" Padding="20" HasShadow="True">
                <Label Text="• Gaming&#10;• PC Building &amp; Hardware Troubleshooting&#10;• Cloud Computing" 
                       FontSize="16" TextColor="#E0E0E0" LineHeight="1.5" />
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>